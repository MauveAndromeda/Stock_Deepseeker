# ========================================
# Stock Deepseeker Environment Configuration
# 复制此文件为 .env 并填写您的API密钥
# ========================================

# ========================================
# ChatGPT-5 Nano API Configuration (必需)
# ========================================
# 从 OpenAI 获取您的 API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_gpt5_nano_api_key_here
OPENAI_MODEL=gpt-4o-mini  # 使用 gpt-4o-mini 或 gpt-4-turbo (GPT-5 Nano尚未发布)
OPENAI_API_BASE=https://api.openai.com/v1

# ========================================
# 数据提供商 API Keys
# ========================================
# Yahoo Finance (免费，无需API key)

# Alpha Vantage (免费): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo  # 使用 'demo' 进行测试

# Polygon.io (付费): https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca (免费纸盘交易): https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Tushare (中国市场，可选)
TUSHARE_TOKEN=your_tushare_token_here

# ========================================
# 回测配置
# ========================================
BACKTEST_START_DATE=2019-01-01  # 5年回测起始日期
BACKTEST_END_DATE=2024-01-01    # 回测结束日期
BACKTEST_INITIAL_CAPITAL=100000  # 初始资金 $100,000
BACKTEST_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA  # 回测股票列表

# ========================================
# 交易配置
# ========================================
TRADING_MODE=paper  # paper (模拟) 或 live (实盘)
ENVIRONMENT=production  # development, testing, staging, production
RISK_MAX_POSITION_SIZE=0.1  # 单个持仓最大10%
RISK_MAX_PORTFOLIO_RISK=0.2  # 组合最大风险20%

# 券商API配置（实盘交易时需要）
BROKER_ACCOUNT=your_broker_account
BROKER_API_KEY=your_broker_api_key
BROKER_API_SECRET=your_broker_api_secret

# ========================================
# 监控和告警
# ========================================
# Email 告警 (可选)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=your_alert_email@gmail.com
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Slack 告警 (可选)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
WEBHOOK_URL=your_webhook_url

# ========================================
# 数据库配置
# ========================================
DATABASE_URL=sqlite:///./data/stock_deepseeker.db
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/stock_deepseeker.log
LOG_FORMAT=colored  # colored, json, simple
