# =============================================================================
# STOCK DEEPSEEKER CONFIGURATION
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# API KEYS - DATA PROVIDERS
# =============================================================================

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Polygon.io
POLYGON_API_KEY=your_polygon_key_here

# Finnhub
FINNHUB_API_KEY=your_finnhub_key_here

# IEX Cloud
IEX_CLOUD_API_KEY=your_iex_cloud_key_here

# Quandl
QUANDL_API_KEY=your_quandl_key_here

# News API
NEWS_API_KEY=your_news_api_key_here

# Twitter/X API (for sentiment)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# =============================================================================
# LLM APIs
# =============================================================================

# OpenAI (ChatGPT 5 Nano)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano  # Update when available
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# BROKER APIs
# =============================================================================

# Alpaca
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading first!

# Interactive Brokers
IB_HOST=127.0.0.1
IB_PORT=7497  # 7497 for paper trading, 7496 for live
IB_CLIENT_ID=1
IB_ACCOUNT_ID=your_ib_account_id_here

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL + TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_deepseeker
POSTGRES_USER=deepseeker
POSTGRES_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# MongoDB (for alternative data)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=deepseeker_alt_data
MONGO_USER=deepseeker
MONGO_PASSWORD=your_mongo_password_here

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Capital
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.05  # Max 5% per position
MAX_TOTAL_RISK=0.20  # Max 20% total portfolio risk

# Risk Management
MAX_DAILY_LOSS=0.03  # 3% daily loss limit
MAX_DRAWDOWN=0.15  # 15% max drawdown
POSITION_STOP_LOSS=0.02  # 2% stop loss per position
TRAILING_STOP=0.03  # 3% trailing stop

# Execution
EXECUTION_DELAY_MS=100  # Delay between orders
MAX_SLIPPAGE=0.001  # 0.1% max slippage tolerance
USE_LIMIT_ORDERS=true

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Transformer
TRANSFORMER_HIDDEN_SIZE=512
TRANSFORMER_NUM_LAYERS=6
TRANSFORMER_NUM_HEADS=8
TRANSFORMER_DROPOUT=0.1
TRANSFORMER_SEQ_LENGTH=60  # 60 timesteps

# SAC (Soft Actor-Critic)
SAC_LEARNING_RATE=0.0003
SAC_BUFFER_SIZE=1000000
SAC_BATCH_SIZE=256
SAC_GAMMA=0.99
SAC_TAU=0.005

# Training
TRAIN_TEST_SPLIT=0.8
VALIDATION_SPLIT=0.1
RANDOM_SEED=42

# =============================================================================
# DATA COLLECTION
# =============================================================================

# S&P 500 Stocks
SP500_UPDATE_INTERVAL=86400  # 24 hours
PRICE_DATA_INTERVAL=60  # 1 minute
NEWS_FETCH_INTERVAL=300  # 5 minutes
SENTIMENT_UPDATE_INTERVAL=600  # 10 minutes

# Historical Data
HISTORICAL_START_DATE=2020-01-01
HISTORICAL_LOOKBACK_DAYS=1000

# =============================================================================
# MONITORING & ALERTS
# =============================================================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_HOST=localhost
GRAFANA_PORT=3000

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#trading-alerts

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_here
ALERT_EMAIL=alerts@yourcompany.com

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# BACKTESTING
# =============================================================================

BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.001  # 0.1% commission

# =============================================================================
# PERFORMANCE
# =============================================================================

# Parallelization
NUM_WORKERS=8
USE_GPU=true
GPU_DEVICE=0

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour

# =============================================================================
# SECURITY
# =============================================================================

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# LOGGING
# =============================================================================

LOG_FILE_PATH=logs/trading.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days
LOG_FORMAT=json

# =============================================================================
# MISC
# =============================================================================

TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
